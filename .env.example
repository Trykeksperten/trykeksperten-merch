# Kun server-side. Kopiér til .env og indsæt din egen nøgle lokalt.
OPENAI_API_KEY=
AI_ENABLED=0
OPENAI_IMAGE_MODEL=gpt-image-2

# Vedvarende serverdata. På Render monteres en disk på /var/data.
SMERCH_DATA_DIR=

# PF Concept: kontospecifikke feeds eller lokale JSON-filer.
PF_PRICE_FEED_URL=
PF_PRINT_PRICE_FEED_URL=
PF_STOCK_FEED_URL=
PF_PRICE_FILE=
PF_PRINT_PRICE_FILE=
PF_STOCK_FILE=
# Genindlæs pris- og lagerfeeds hver time, når alle tre feeds/filer er konfigureret.
# Minimum 15 minutter; sæt til 0 for at slå automatisk genindlæsning fra.
PF_PRICE_SYNC_INTERVAL_MINUTES=60
# Standardvarer og tryk prissættes til ca. 50 % bruttomargin. Caps og huer
# beholder den nuværende effektive vareavance. PF-opstart får 50 % avance og
# rundes derefter op til nærmeste 50 DKK pr. placering.
# Småordretillæg og fragt viderefaktureres uden avance.
# Fragt vises først, når en dokumenteret leverandørpris findes; den skal også viderefaktureres uden avance.
# 100 % tillæg på indkøbsprisen svarer til 50 % bruttomargin.
PF_GOODS_MARKUP_PERCENT=100
PF_PRINT_MARKUP_PERCENT=100
PF_SETUP_MARKUP_PERCENT=50
PF_HEADWEAR_GOODS_MARKUP_PERCENT=112.5

# PF Online Gateway (server-only). "off" er standard; brug testkonto først.
PF_GATEWAY_MODE=off
PF_GATEWAY_USERNAME=
PF_GATEWAY_TEST_PASSWORD=
PF_GATEWAY_PROD_PASSWORD=
PF_GATEWAY_SENDER_ID=
# Skal være en eksisterende PF Store-bruger, som skal modtage PF's korrektur.
PF_COMMUNICATION_EMAIL=
# Offentlige Smerch-adresser. Hold korrekturmailen adskilt fra almindelig kundeservice.
SMERCH_CONTACT_EMAIL=hello@smerch.dk
SMERCH_PROOF_EMAIL=korrektur@smerch.dk
# Ekstra spærring: live kan ikke bruges uden denne eksplicitte værdi.
PF_GATEWAY_LIVE_ENABLED=0
# Automatisk afsendelse efter verificeret betalingsreservation. Hold på 0 indtil test hos PF.
PF_AUTO_SUBMIT_ENABLED=0
# Sæt først til 1 når PF skriftligt har bekræftet levering af e-proof til den aftalte indbakke.
PF_PROOF_DELIVERY_CONFIRMED=0
# Sæt først til 1 når PF har bekræftet Smerch som afsender på label/følgeseddel/returadresse.
PF_WHITE_LABEL_CONFIRMED=0
# En eksplicit verificeret hex -> PF Pantone-kode, fx {"#17201f":"Black C"}.
# Uafklarede eller flerfarvede logoer blokeres før automatisk PF-afsendelse.
SMERCH_PMS_COLOR_MAP={}
# Tilfældig hemmelighed på mindst 32 tegn til tidsbegrænsede HTTPS-links til originale trykfiler.
SMERCH_ARTWORK_SIGNING_SECRET=
# Lange, tilfældige hemmeligheder. Admin-token bruges til interne ordrehandlinger.
PF_ORDER_ADMIN_TOKEN=
PF_PROOF_INBOX_TOKEN=
# Medarbejderlogin til /admin/pf-orders. Gem kun en scrypt-hash (salt:hash), aldrig adgangskoden.
SMERCH_ADMIN_USERNAME=
SMERCH_ADMIN_PASSWORD_HASH=
# PF bruger Basic Auth til callbacks til /api/pf-callback/*.
PF_CALLBACK_USERNAME=
PF_CALLBACK_PASSWORD=
# Signering fra et kontrolleret PF-relæ til callbacks og korrekturindbakke (min. 32 tegn i live).
PF_WEBHOOK_SIGNING_SECRET=

# Vælg betalingsgateway. Quickpay er den foretrukne nye integration; ældre Stripe-ordrer bevarer Stripe.
PAYMENT_PROVIDER=quickpay
# Quickpay v10 Payment Link. Nøgler må kun ligge på serveren.
QUICKPAY_MODE=test
QUICKPAY_API_KEY=
# Kontoens private key til HMAC på rå callback-body, IKKE API-nøglen.
QUICKPAY_PRIVATE_KEY=
# Verificér reservationsperioden med jeres indløser. Timer; kræves eksplicit i live.
QUICKPAY_AUTH_HOLD_HOURS=
# Begræns Quickpay-vinduet til MobilePay, Apple Pay og kort, hvis alle er aktiveret.
QUICKPAY_PAYMENT_METHODS=mobilepay,apple-pay,creditcard
QUICKPAY_LIVE_ENABLED=0
QUICKPAY_CAPTURE_ENABLED=0

# Stripe Checkout (legacy/valgfri). Nøgler sættes kun på serveren.

# Apple Pay vises af Stripe for understøttede enheder/browsere via kortbetaling.
# Aktivér MobilePay i Stripe-kontoen, og konfigurer webhook til /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMERCH_PUBLIC_BASE_URL=http://localhost:5173
# Dokumenteret PF-fragt uden avance, ekskl. moms, KUN for ét verificeret
# produktionssted og en ordre, hvor PF har bekræftet denne sats. PF-fragt
# varierer med service og ordrens størrelse; erstat med faktisk fragtberegning
# før generel livebetaling. Ukendt produktionssted afvises altid af checkout.
SMERCH_FREIGHT_EX_VAT_DKK=
# Verificeret PF-fragt pr. produktionssted, uden avance, ekskl. moms.
# Begge kræves ved kurve med varer fra både Polen og Storbritannien.
SMERCH_FREIGHT_PL_EX_VAT_DKK=
SMERCH_FREIGHT_UK_EX_VAT_DKK=
# Ekstra spærring for livebetaling.
STRIPE_LIVE_ENABLED=0
# Kræves for automatisk hævning efter intern godkendelse af ALLE korrekturer.
STRIPE_CAPTURE_ENABLED=0
